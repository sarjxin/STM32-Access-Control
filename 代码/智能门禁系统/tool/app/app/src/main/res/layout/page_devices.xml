<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="20dp">
        <LinearLayout style="@style/Card" android:layout_marginTop="8dp">
            <TextView style="@style/Eyebrow" android:text="@string/bluetooth_connection"/>
            <TextView style="@style/Title" android:layout_marginTop="13dp" android:text="@string/page_devices_text_01" android:textSize="20sp"/>
            <TextView style="@style/Body" android:layout_marginTop="10dp" android:text="@string/page_devices_text_02"/>
            <Button android:id="@+id/system_bluetooth" style="@style/Secondary" android:layout_marginTop="16dp" android:text="@string/page_devices_text_03"/>
            <Button android:id="@+id/refresh_devices" style="@style/Action" android:layout_marginTop="10dp" android:text="@string/page_devices_text_04"/>
            <TextView android:id="@+id/device_hint" style="@style/Body" android:layout_marginTop="12dp" android:text="@string/page_devices_text_05" android:textSize="12sp" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
        <TextView style="@style/Title" android:text="@string/page_devices_text_06" android:textSize="14sp" android:layout_marginBottom="12dp"/>
        <LinearLayout android:id="@+id/device_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <Button android:id="@+id/disconnect_button" style="@style/Secondary" android:text="@string/page_devices_text_07" android:layout_marginTop="4dp"/>
        <TextView style="@style/Body" android:layout_marginTop="16dp" android:text="@string/page_devices_text_08" android:textSize="11sp"/>
    </LinearLayout>
</ScrollView>
