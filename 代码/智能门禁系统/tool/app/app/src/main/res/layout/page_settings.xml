<!-- These are protocol fields; MainActivity also disables personal-data autofill at runtime. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="Autofill" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="20dp">
        <LinearLayout style="@style/Card" android:layout_marginTop="8dp">
            <TextView style="@style/Eyebrow" android:text="@string/protocol_settings"/>
            <TextView style="@style/Title" android:layout_marginTop="13dp" android:text="@string/page_settings_text_01" android:textSize="20sp"/>
            <TextView style="@style/Body" android:layout_marginTop="8dp" android:text="@string/page_settings_text_02"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="6dp">
                    <TextView style="@style/FieldLabel" android:text="@string/page_settings_text_03" android:labelFor="@id/command_unlock"/>
                    <EditText android:id="@+id/command_unlock" style="@style/Field"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="6dp">
                    <TextView style="@style/FieldLabel" android:text="@string/page_settings_text_04" android:labelFor="@id/command_lock"/>
                    <EditText android:id="@+id/command_lock" style="@style/Field"/>
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/FieldLabel" android:text="@string/page_settings_text_05" android:labelFor="@id/command_query"/>
            <EditText android:id="@+id/command_query" style="@style/Field"/>
            <TextView style="@style/FieldLabel" android:text="@string/page_settings_text_06" android:labelFor="@id/line_ending"/>
            <Spinner android:id="@+id/line_ending" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_spinner" android:popupBackground="@color/card" android:contentDescription="@string/page_settings_text_06"/>
            <TextView style="@style/FieldLabel" android:text="@string/page_settings_text_08" android:labelFor="@id/reply_unlocked"/>
            <EditText android:id="@+id/reply_unlocked" style="@style/Field"/>
            <TextView style="@style/FieldLabel" android:text="@string/page_settings_text_09" android:labelFor="@id/reply_locked"/>
            <EditText android:id="@+id/reply_locked" style="@style/Field"/>
            <TextView style="@style/Body" android:layout_marginTop="10dp" android:text="@string/page_settings_text_10" android:textSize="11sp"/>
            <Button android:id="@+id/save_settings" style="@style/Action" android:layout_marginTop="16dp" android:text="@string/page_settings_text_11"/>
            <Button android:id="@+id/reset_settings" style="@style/Secondary" android:layout_marginTop="10dp" android:text="@string/page_settings_text_12"/>
            <TextView android:id="@+id/settings_hint" style="@style/Body" android:layout_marginTop="12dp" android:text="@string/page_settings_text_13" android:textSize="11sp" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
        <LinearLayout style="@style/Card">
            <TextView style="@style/Title" android:text="@string/page_settings_text_14" android:textSize="17sp"/>
            <Spinner android:id="@+id/send_mode" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/bg_spinner" android:popupBackground="@color/card" android:contentDescription="@string/page_settings_contentDescription_15"/>
            <EditText android:id="@+id/manual_input" style="@style/Field" android:layout_marginTop="10dp" android:hint="@string/page_settings_hint_16" android:maxLength="1536"/>
            <TextView style="@style/Body" android:layout_marginTop="8dp" android:text="@string/page_settings_text_17" android:textSize="11sp"/>
            <Button android:id="@+id/manual_send" style="@style/Action" android:layout_marginTop="12dp" android:text="@string/page_settings_text_18"/>
        </LinearLayout>
        <LinearLayout style="@style/Card">
            <TextView style="@style/Title" android:text="@string/page_settings_text_19" android:textSize="17sp"/>
            <TextView style="@style/Body" android:layout_marginTop="8dp" android:text="@string/page_settings_text_20" android:textSize="11sp"/>
            <Button android:id="@+id/clear_log" style="@style/Secondary" android:layout_marginTop="12dp" android:text="@string/page_settings_text_21"/>
            <TextView android:id="@+id/log_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="14dp" android:background="@drawable/bg_field" android:text="@string/page_settings_text_22" android:textColor="@color/muted" android:textSize="11sp" android:fontFamily="monospace" android:textIsSelectable="true" android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
