<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_bluetooth" android:tint="@color/muted" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/control_connection" style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="12sp" android:text="@string/bluetooth_disconnected"/>
            <Button android:id="@+id/manage_device" style="@style/Secondary" android:layout_width="wrap_content" android:minHeight="48dp" android:background="@drawable/bg_text_button" android:paddingStart="8dp" android:paddingEnd="4dp" android:textSize="12sp" android:textColor="@color/green" android:text="@string/connect_short"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_hero"
            android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="16dp" android:paddingBottom="18dp" android:gravity="center_horizontal" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:text="@string/page_control_text_01"/>
                <TextView android:id="@+id/state_tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_state_tag" android:text="@string/state_unknown" android:textSize="11sp" android:textColor="@color/muted" android:fontFamily="monospace"/>
            </LinearLayout>
            <FrameLayout android:layout_width="120dp" android:layout_height="120dp" android:layout_marginTop="12dp" android:layout_marginBottom="10dp">
                <cn.dooraccess.app.StatusHaloView android:id="@+id/status_halo" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"/>
                <ImageView android:id="@+id/lock_icon" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:src="@drawable/ic_lock" android:importantForAccessibility="no"/>
            </FrameLayout>
            <TextView android:id="@+id/lock_state" style="@style/Title" android:text="@string/page_control_text_02" android:textSize="28sp" android:gravity="center" android:accessibilityLiveRegion="polite"/>
            <TextView android:id="@+id/lock_detail" style="@style/Body" android:layout_marginTop="6dp" android:text="@string/page_control_text_03" android:textSize="12sp" android:gravity="center"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
            <TextView style="@style/Title" android:layout_width="0dp" android:layout_weight="1" android:text="@string/page_control_text_04" android:textSize="14sp"/>
            <TextView style="@style/Eyebrow" android:layout_width="wrap_content" android:text="@string/quick_control"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/unlock_button" style="@style/Action" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:minHeight="78dp" android:text="@string/page_control_text_05" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_unlock_action" android:textSize="17sp"/>
            <Button android:id="@+id/lock_button" style="@style/Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:minHeight="78dp" android:text="@string/page_control_text_06" android:gravity="center_vertical|start" android:drawableStart="@drawable/ic_lock_action" android:textSize="17sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/query_button" style="@style/Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:textSize="13sp" android:drawableStart="@drawable/ic_query" android:text="@string/page_control_text_07"/>
            <Button android:id="@+id/exit_button" style="@style/Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:textSize="13sp" android:drawableStart="@drawable/ic_exit" android:text="@string/exit_button_text"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top" android:layout_marginTop="12dp" android:layout_marginBottom="13dp">
            <TextView android:id="@+id/feedback_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_dot" android:textSize="14sp" android:textColor="@color/muted" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/action_hint" style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="12sp" android:text="@string/page_control_text_08" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
        <LinearLayout style="@style/Card" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp" android:src="@drawable/ic_bluetooth" android:background="@drawable/bg_device_icon" android:tint="@color/green" android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/current_device" style="@style/Title" android:textSize="13sp" android:text="@string/page_control_text_10"/>
                <TextView android:id="@+id/current_device_detail" style="@style/Body" android:layout_marginTop="5dp" android:textSize="11sp" android:text="@string/select_paired_device"/>
            </LinearLayout>
            <ImageButton android:id="@+id/go_devices" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_text_button" android:src="@drawable/ic_chevron" android:tint="@color/green" android:contentDescription="@string/page_control_text_11"/>
        </LinearLayout>
        <TextView style="@style/Body" android:text="@string/page_control_text_12" android:textSize="11sp" android:gravity="center"/>
    </LinearLayout>
</ScrollView>
